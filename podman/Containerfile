# Build image of the game. The Linux release builds in this image, so that the
# toolchain and the libraries are the same on each machine and each build.
#
# The base image is rust 1.99.1 on Debian 13 (trixie), pinned by digest.
# The Debian packages come from snapshot.debian.org at a fixed date, so that
# a rebuild of this image installs the same package versions.
FROM docker.io/library/rust@sha256:7eab7ce19273ce785e0ca7578bdf7bc1fcbae621775a8197379a04c9f6e03cd5

# The date must be after the base image, so that its security updates
# are in the snapshot.
ARG DEBIAN_SNAPSHOT=20261108T000000Z

# libasound2-dev and pkg-config: the rodio audio (cpal) links ALSA on Linux.
# The window (winit and softbuffer) loads X11 and Wayland at run time, so it
# needs no headers.
RUN rm -f /etc/apt/sources.list.d/debian.sources \
 && S=http://snapshot.debian.org/archive \
 && printf 'deb [check-valid-until=no] %s/debian/%s trixie main\ndeb [check-valid-until=no] %s/debian/%s trixie-updates main\ndeb [check-valid-until=no] %s/debian-security/%s trixie-security main\n' \
      "$S" "$DEBIAN_SNAPSHOT" "$S" "$DEBIAN_SNAPSHOT" "$S" "$DEBIAN_SNAPSHOT" > /etc/apt/sources.list \
 && apt-get -o Acquire::Retries=3 update \
 && apt-get install -y --no-install-recommends \
      ca-certificates pkg-config libasound2-dev file \
 && rm -rf /var/lib/apt/lists/*

RUN rustup component add clippy rustfmt

ENV CARGO_HOME=/cache/cargo \
    CARGO_TERM_COLOR=never

WORKDIR /src
